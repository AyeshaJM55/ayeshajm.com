<script>
// Guard against running twice — facets-vertical is rendered for both
// desktop and mobile locations on the same page.
if (!window._facetSyncInitialized) {
  window._facetSyncInitialized = true;
  (function() {
    var refreshTimer = null;

    function syncFilterStates(url) {
      fetch(url || location.href)
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');

          // Sync both desktop sidebar and mobile drawer
          ['.facets-sidebar', '.sidebar__body'].forEach(function(containerSel) {
            var container = document.querySelector(containerSel);
            if (!container) return;

            doc.querySelectorAll(containerSel + ' input[type="checkbox"]').forEach(function(newInput) {
              var selector = 'input[type="checkbox"][name="' + CSS.escape(newInput.name) + '"][value="' + CSS.escape(newInput.value) + '"]';
              var currentInput = container.querySelector(selector);
              if (!currentInput) return;

              currentInput.disabled = newInput.disabled;
              var label = currentInput.closest('label');
              if (label) {
                label.classList.toggle('facet-checkbox--disabled', newInput.disabled);
              }
            });
          });
        })
        .catch(function() {});
    }

    // Primary trigger: pushState intercept (desktop AJAX)
    var _origPush = history.pushState.bind(history);
    history.pushState = function(state, title, url) {
      _origPush(state, title, url);
      clearTimeout(refreshTimer);
      var absUrl = url ? new URL(url, location.origin).href : location.href;
      refreshTimer = setTimeout(function() { syncFilterStates(absUrl); }, 50);
    };

    // Also intercept replaceState (some themes use this instead)
    var _origReplace = history.replaceState.bind(history);
    history.replaceState = function(state, title, url) {
      _origReplace(state, title, url);
      if (url) {
        clearTimeout(refreshTimer);
        var absUrl = new URL(url, location.origin).href;
        refreshTimer = setTimeout(function() { syncFilterStates(absUrl); }, 50);
      }
    };

    // Fallback trigger: direct checkbox change listener
    // Catches mobile drawer which may not fire pushState until drawer closes.
    document.addEventListener('change', function(e) {
      if (e.target.matches('.facets__form input[type="checkbox"]')) {
        clearTimeout(refreshTimer);
        // Wait 600ms — gives pushState time to fire first so we use the
        // updated URL; if pushState already ran, this is a harmless second call.
        refreshTimer = setTimeout(function() { syncFilterStates(location.href); }, 600);
      }
    });

    window.addEventListener('popstate', function() {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(function() { syncFilterStates(location.href); }, 50);
    });
  })();
}
