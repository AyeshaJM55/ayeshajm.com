<script>
  (function() {
    function getHeaderElements(fromElement) {
      var header = fromElement.closest('.site-header');
      if (!header) return {};

      return {
        header: header,
        menuList: header.querySelector('.header-menu-with-search'),
        searchForm: header.querySelector('[data-header-search-form]'),
        siteNavContainer: header.querySelector('.site-nav-container')
      };
    }

    function openSearchFor(els) {
      if (!els.header || !els.searchForm) return;
      document.body.classList.add('site-header--search-open');
      if (els.header.classList.contains('site-header--absolute') || els.header.classList.contains('dark-mode')) {
        document.body.classList.add('dark-mode');
      }
      var input = els.searchForm.querySelector('input[type="search"]');
      if (input) {
        input.focus();
      }
    }

    function closeSearchFor(els) {
      document.body.classList.remove('site-header--search-open');
      if (!document.body.classList.contains('mega-menu-open')) {
        document.body.classList.remove('dark-mode');
      }
    }

    function closeAllSearchMenus() {
      document.body.classList.remove('site-header--search-open');
      if (!document.body.classList.contains('mega-menu-open')) {
        document.body.classList.remove('dark-mode');
      }
    }

    var searchCloseTimeout;

    function scheduleCloseSearch(els) {
      searchCloseTimeout = window.setTimeout(function() {
        closeSearchFor(els);
      }, 200);
    }

    function cancelCloseSearch() {
      if (searchCloseTimeout) {
        window.clearTimeout(searchCloseTimeout);
        searchCloseTimeout = null;
      }
    }

    document.querySelectorAll('.site-header').forEach(function(header) {
      var searchItem = header.querySelector('.header-menu-with-search .menu-item--search');
      if (!searchItem) return;
      var els = getHeaderElements(searchItem);

      var form = header.querySelector('[data-header-search-form]');
      if (form) {
        form.addEventListener('focusin', function() {
          cancelCloseSearch();
          openSearchFor(els);
        });
        form.addEventListener('focusout', function() {
          scheduleCloseSearch(els);
        });
      }
    });

    document.addEventListener('click', function(event) {
      var toggle = event.target.closest('[data-header-search-toggle]');
      if (toggle) {
        event.preventDefault();
        var els = getHeaderElements(toggle);
        if (els.header && els.searchForm) {
          cancelCloseSearch();
          if (document.body.classList.contains('site-header--search-open')) {
            closeSearchFor(els);
          } else {
            openSearchFor(els);
          }
        }
        return;
      }

      var clearButton = event.target.closest('[data-header-search-clear]');
      if (clearButton) {
        event.preventDefault();
        var els = getHeaderElements(clearButton);
        if (!els.header) return;

        closeSearchFor(els);
        var input = els.searchForm && els.searchForm.querySelector('input[type="search"]');
        if (input) {
          input.value = '';
        }
      }
    });

    document.addEventListener('keyup', function(event) {
      if (event.key === 'Escape' || event.keyCode === 27) {
        closeAllSearchMenus();
      }
    });
  })();
</script>

