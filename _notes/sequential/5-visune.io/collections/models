  /* ── Product card hover effects ─────────────────────────────────────── */
  /* Image-swap on non-material collections */
  .product-item .image-container .image-overlay {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .product-item .image-container .hide-on-hover {
    transition: opacity 0.25s ease;
  }
  .product-item .image-container:not(.image-container__zoom_hover):hover .hide-on-hover {
    opacity: 0;
  }
  .product-item .image-container:not(.image-container__zoom_hover):hover .image-overlay {
    opacity: 1;
  }

  /* Zoom on material (vertical) collections */
  .product-item .image-container__zoom_hover {
    overflow: hidden;
  }
  .product-item .image-container__zoom_hover img {
    transition: transform 0.35s ease;
    will-change: transform;
  }
  .product-item .image-container__zoom_hover:hover img {
    transform: scale(1.9);
  }

  /* Promo card — horizontal grid (image + gradient) */
  .promo-card-materials {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 20 / 19;
  }
  .promo-card-materials__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .promo-card-materials__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.8) 100%);
  }
  .promo-card-materials__content {
    position: relative;
    z-index: 1;
    padding: 24px;
    color: #fff;
    width: 100%;
  }
  /* Desktop layout */
  .promo-card-materials__mobile { display: none; }
  .promo-card-materials__heading {
    margin: 0 0 20px;
    font-size: 30px;
    font-weight: 100;
    line-height: 1.15;
  }
  .promo-card-materials__btn {
    display: inline-block;
    background: transparent;
    border: 1px solid #fff;
    color: #fff;
    cursor: pointer;
  }
  .promo-card-materials:hover .promo-card-materials__btn {
    background: #fff;
    color: #000;
  }
  /* Mobile layout */
  @media screen and (max-width: 620px) {
    .promo-card-materials__desktop { display: none; }
    .promo-card-materials__mobile { display: block; }
    .promo-card-materials {
      aspect-ratio: 3 / 4;
    }
    .promo-card-materials__content {
      padding: 14px;
    }
    .promo-card-materials__count {
      margin: 0;
      font-size: 32px;
      font-weight: 100;
      line-height: 1;
    }
    .promo-card-materials__subtitle {
      margin: 0;
      font-size: 13px;
      font-weight: 100;
      line-height: 1.2;
    }
  }

  /* Promo card — vertical grid (request a material) */
  .promo-card-request {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    display: flex;
    align-items: flex-end;
    align-self: stretch;
    background: #111;
    text-decoration: none;
  }
  .promo-card-request__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .promo-card-request__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.8) 100%);
  }
  .promo-card-request__content {
    position: relative;
    z-index: 1;
    padding: 24px;
    color: #fff;
    text-align: left;
    width: 100%;
  }
  .promo-card-request__heading {
    margin: 0 0 20px;
    font-size: 24px;
    font-weight: 100;
    line-height: 1.2;
  }
  .promo-card-request__btn {
    display: inline-block;
    background: transparent;
    border: 1px solid #fff;
    color: #fff;
    cursor: pointer;
    padding-left: 2em;
    padding-right: 2em;
  }
  .promo-card-request:hover .promo-card-request__btn {
    background: #fff;
    color: #000;
  }
</style>




