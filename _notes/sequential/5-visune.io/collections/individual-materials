    scrollObserver = new IntersectionObserver(function(entries) {
      if (!entries[0].isIntersecting || loading) return;
      loadNext();
    }, { rootMargin: '200px' });
    scrollObserver.observe(paginationWrapper);
  }

  async function loadNext() {
    const nextLink = getNextLink();
    if (!nextLink) return;

    const grid = getGrid();
    if (!grid) return;

    loading = true;
    const nextUrl = nextLink.href;
    const paginationWrapper = nextLink.closest('div');
    if (paginationWrapper) paginationWrapper.style.visibility = 'hidden';

    try {
      let doc = (prefetchedUrl === nextUrl) ? prefetchedDoc : null;
      prefetchedDoc = null;
      prefetchedUrl = null;

      if (!doc) {
        doc = new DOMParser().parseFromString(
          await (await fetch(nextUrl)).text(),
          'text/html'
        );
      }

      const newGrid = doc.getElementById('main-collection-product-grid');
      if (newGrid) {
        Array.from(newGrid.children).forEach(function(child) {
          const clone = child.cloneNode(true);
          grid.appendChild(clone);
          _infiniteNodes.push(clone);
        });
        initPromoCards();
        _pagesLoaded++;
        _loadedPageUrls.push(nextUrl);
      }

      const newNextLink = doc.querySelector('li.next a');
      if (paginationWrapper) {
        if (newNextLink) {
          paginationWrapper.innerHTML = newNextLink.closest('div')?.innerHTML || paginationWrapper.innerHTML;
          paginationWrapper.style.visibility = 'hidden';
          if (prefetchObserver) prefetchObserver.observe(paginationWrapper);
          if (scrollObserver) scrollObserver.observe(paginationWrapper);
        } else {
          paginationWrapper.remove();
        }
      }
    } catch (e) {
      console.error('Infinite scroll error:', e);
      if (paginationWrapper) paginationWrapper.style.visibility = '';
    } finally {
      loading = false;
    }
  }

  // Promo card image randomisation
  function initPromoCards() {
    document.querySelectorAll('[data-promo-card]:not([data-promo-initialized])').forEach(function(card) {
      var images = [];
      for (var i = 1; i <= 20; i++) {
        var url = card.getAttribute('data-img-' + i);
        if (url) images.push(url);
      }
      if (!images.length) return;
      var img = card.getAttribute('data-selected-img') || images[Math.floor(Math.random() * images.length)];
      var bg = card.querySelector('[data-promo-bg]');
      if (bg) bg.style.backgroundImage = 'url(' + img + ')';
      card.setAttribute('data-promo-initialized', '1');
    });
  }
  document.addEventListener('DOMContentLoaded', initPromoCards);

  // Save scroll position when any button or link inside the product grid is
  // clicked — covers add-to-cart, remove-from-cart (which may use a different
  // element/attribute in its toggled state), and quick-add buttons.
  // _savedScrollY is only acted on if the section actually re-renders.
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#main-collection-product-grid')) return;
    if (!e.target.closest('button, a')) return;
    if (_infiniteNodes.length === 0) return;
    _savedScrollY = window.scrollY;
  }, true);

  // Re-init whenever facets or a cart action causes the section to re-render.
  // For facets: clears nodes and calls init() normally (y stays -1).
  // For cart actions: fetches all previously-loaded pages in parallel (fast
  // from browser cache), appends them all at once, updates the pagination,
  // then restores scroll — so content reappears in one go rather than
  // loading page by page.
  const collectionGrid = document.getElementById('CollectionProductGrid');
  if (collectionGrid) {
    new MutationObserver(function() {
      // Only reset content state here — do NOT consume _savedScrollY or
      // _loadedPageUrls yet.  A remove-from-cart can fire two re-renders
