      clearTimeout(debounceTimer);
      _infiniteNodes = [];
      _pagesLoaded = 0;
      debounceTimer = setTimeout(async function() {
        var urlsToReload = _loadedPageUrls.slice();
        _loadedPageUrls = [];
        var y = _savedScrollY;
        _savedScrollY = -1;

        if (y >= 0 && urlsToReload.length > 0) {
          // Fetch all previously-loaded pages simultaneously (fast from cache)
          var docs = await Promise.all(urlsToReload.map(function(url) {
            return fetch(url)
              .then(function(r) { return r.text(); })
              .then(function(t) { return new DOMParser().parseFromString(t, 'text/html'); })
              .catch(function() { return null; });
          }));

          var grid = getGrid();
          if (grid) {
            docs.forEach(function(doc, idx) {
              if (!doc) return;
              var newGrid = doc.getElementById('main-collection-product-grid');
              if (!newGrid) return;
              Array.from(newGrid.children).forEach(function(child) {
                var clone = child.cloneNode(true);
                grid.appendChild(clone);
                _infiniteNodes.push(clone);
              });
              initPromoCards();
              _pagesLoaded++;
              _loadedPageUrls.push(urlsToReload[idx]); // repopulate for next cart action
            });

            // Update pagination to point past the last reloaded page
            var lastDoc = docs.filter(Boolean).pop();
            if (lastDoc) {
              var newNextLink = lastDoc.querySelector('li.next a');
              var paginationWrapper = getNextLink() ? getNextLink().closest('div') : null;
              if (paginationWrapper) {
                if (newNextLink) {
                  paginationWrapper.innerHTML = newNextLink.closest('div') ? newNextLink.closest('div').innerHTML : paginationWrapper.innerHTML;
                } else {
                  paginationWrapper.remove();
                }
              }
            }
          }

          init();
          window.scrollTo(0, y);
        } else {
          init();
          if (y >= 0) window.scrollTo(0, y);
        }
      }, 100);
    }).observe(collectionGrid, { childList: true, subtree: false });
  }

  init();
})();


