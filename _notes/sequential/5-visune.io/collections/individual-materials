function forceDownload(url) {
  var a = document.createElement('a');
  a.href = url;
  document.body.appendChild(a);
  a.click();
  a.remove();
}

function getDownloadLink(e) {
	if(e) {
    	e.preventDefault();
    	e.stopPropagation();
  	}
	const thisButton = e.target.closest('.button--download-asset');
	thisButton.setAttribute('disabled','disabled');
	thisButton.classList.add('working');

	if(document.getElementById('downloadErrorWarning')) {
		document.getElementById('downloadErrorWarning').style.display = 'none';
	}

	let config = {
		method: 'POST',
    	headers: {
	    	'Content-Type': 'application/x-www-form-urlencoded',
	    	'Accept': 'application/json',
	    	'X-ABSOLUTE-HMAC': thisButton.getAttribute('data-hash'), 
	    	'X-ABSOLUTE-SESSION': thisButton.getAttribute('data-session') 
    	},
    	body: 'variant_id='+thisButton.getAttribute('data-variant')+'&customer_id='+thisButton.getAttribute('data-customer')
    }

	fetch('https://visune.sawblade.org.uk/api/S3/download.php', config)
      .then((response) => response.json())
      .then((response) => {
        if(typeof response.status !== "undefined") {

        	if (response.status == 'success') {
        		// start the download:
        		forceDownload(response.file_url);
        	} else {
        		// error handling
        		window.localStorage.setItem("download-error", response.reason);window.location.reload();
        	}
        }
        thisButton.removeAttribute('disabled');
        thisButton.classList.remove('working');
      })
      .finally(() => {
        // 
    });
}


function initDownloadButtons() {
const allDownloadButtons = document.querySelectorAll('.button--download-asset');
	if (allDownloadButtons.length > 0) {
		for (i = 0; i < allDownloadButtons.length; i++) {
			allDownloadButtons[i].onclick = getDownloadLink;
		}
	}	
}


if(window.localStorage.getItem('download-error') !== null) {
	document.getElementById('downloadErrorWarningDynamic').innerHTML = window.localStorage.getItem('download-error');
	document.getElementById('downloadErrorWarning').style.display = 'block';
	localStorage.removeItem("download-error");
}

initDownloadButtons();

(function () {
  let loading = false;
  let prefetching = false;
  let prefetchedDoc = null;
  let prefetchedUrl = null;
  let scrollObserver = null;
  let prefetchObserver = null;
  let debounceTimer = null;
  let _infiniteNodes = [];
  let _pagesLoaded = 0;
  let _loadedPageUrls = [];
  let _savedScrollY = -1;
  let _scrollRestoreTimer = null;

  function getGrid() {
    return document.getElementById('main-collection-product-grid');
  }

  function getNextLink() {
    return document.querySelector('li.next a');
  }

  function preloadImages(doc) {
    const imgs = doc.querySelectorAll('#main-collection-product-grid img');
    imgs.forEach(function(img) {
      const src = img.getAttribute('src') || img.getAttribute('data-src');
      if (!src || src.startsWith('data:')) return;
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.href = src;
      const srcset = img.getAttribute('srcset') || img.getAttribute('data-srcset');
      if (srcset) link.imageSrcset = srcset;
      document.head.appendChild(link);
    });

    // Preload promo card background images
    doc.querySelectorAll('[data-promo-card]').forEach(function(card) {
      var images = [];
      for (var i = 1; i <= 20; i++) {
        var url = card.getAttribute('data-img-' + i);
        if (url) images.push(url);
      }
      if (!images.length) return;
      var selected = images[Math.floor(Math.random() * images.length)];
      card.setAttribute('data-selected-img', selected);
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.href = selected;
      document.head.appendChild(link);
    });
  }

  async function prefetchNext() {
    const nextLink = getNextLink();
    if (!nextLink || prefetching || prefetchedDoc) return;
    const url = nextLink.href;
    if (url === prefetchedUrl) return;
    prefetching = true;
    prefetchedUrl = url;
    try {
      const text = await (await fetch(url)).text();
      prefetchedDoc = new DOMParser().parseFromString(text, 'text/html');
      preloadImages(prefetchedDoc);
    } catch (e) {
      prefetchedUrl = null;
    } finally {
      prefetching = false;
    }
  }

  function init() {
    loading = false;
    prefetchedDoc = null;
    prefetchedUrl = null;
    if (scrollObserver) scrollObserver.disconnect();
    if (prefetchObserver) prefetchObserver.disconnect();

    const nextLink = getNextLink();
    if (!nextLink) return;

    const paginationWrapper = nextLink.closest('div');
    if (!paginationWrapper) return;

    paginationWrapper.style.visibility = 'hidden';

    // Fires 800px before pagination enters view — fetches next page and preloads its images
    prefetchObserver = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) prefetchNext();
    }, { rootMargin: '800px' });
    prefetchObserver.observe(paginationWrapper);

