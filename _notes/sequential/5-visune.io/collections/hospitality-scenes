  }

  function preloadImages(doc) {
    const imgs = doc.querySelectorAll('#main-collection-product-grid img');
    imgs.forEach(function(img) {
      const src = img.getAttribute('src') || img.getAttribute('data-src');
      if (!src || src.startsWith('data:')) return;
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.href = src;
      const srcset = img.getAttribute('srcset') || img.getAttribute('data-srcset');
      if (srcset) link.imageSrcset = srcset;
      document.head.appendChild(link);
    });

    // Preload promo card background images
    doc.querySelectorAll('[data-promo-card]').forEach(function(card) {
      var images = [];
      for (var i = 1; i <= 20; i++) {
        var url = card.getAttribute('data-img-' + i);
        if (url) images.push(url);
      }
      if (!images.length) return;
      var selected = images[Math.floor(Math.random() * images.length)];
      card.setAttribute('data-selected-img', selected);
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.href = selected;
      document.head.appendChild(link);
    });
  }

  async function prefetchNext() {
    const nextLink = getNextLink();
    if (!nextLink || prefetching || prefetchedDoc) return;
    const url = nextLink.href;
    if (url === prefetchedUrl) return;
    prefetching = true;
    prefetchedUrl = url;
    try {
      const text = await (await fetch(url)).text();
      prefetchedDoc = new DOMParser().parseFromString(text, 'text/html');
