        	} else {
        		// error handling
        		window.localStorage.setItem("download-error", response.reason);window.location.reload();
        	}
        }
        thisButton.removeAttribute('disabled');
        thisButton.classList.remove('working');
      })
      .finally(() => {
        // 
    });
}


