  function initPromoCards() {
    document.querySelectorAll('[data-promo-card]:not([data-promo-initialized])').forEach(function(card) {
      var images = [];
      for (var i = 1; i <= 20; i++) {
        var url = card.getAttribute('data-img-' + i);
        if (url) images.push(url);
      }
      if (!images.length) return;
      var img = card.getAttribute('data-selected-img') || images[Math.floor(Math.random() * images.length)];
      var bg = card.querySelector('[data-promo-bg]');
